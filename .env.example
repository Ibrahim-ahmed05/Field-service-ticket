# =============================================================================
# Field Service Ticket System — Environment Configuration Template
# =============================================================================

# MongoDB Atlas or Local MongoDB Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/fieldservice?retryWrites=true&w=majority
MONGODB_DB=fieldservice

# Server Port & Environment
PORT=3000
NODE_ENV=development

# Notification Provider for development ("DevLog", "WhatsApp", "Email", "SMS")
NOTIFICATION_PROVIDER=DevLog

# Optional: Third-party Notification Provider Keys (for WhatsApp / Email / SMS integration)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
SENDGRID_API_KEY=
RESEND_API_KEY=
SYSTEM_FROM_EMAIL=dispatch@fieldservice.local
